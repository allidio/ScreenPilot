{
  "manifest_version": 3,
  "name": "AI Screen Navigator",
  "version": "1.2",
  "description": "Voice-controlled screen navigator with API key input.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}